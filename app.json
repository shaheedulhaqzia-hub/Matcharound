{
  "expo": {
    "name": "Matcharound",
    "slug": "Matcharound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "matcharound",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matcharound.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Matcharound uses the camera for video calls with nearby matches.",
        "NSMicrophoneUsageDescription": "Matcharound uses the microphone for voice and video calls.",
        "NSLocationWhenInUseUsageDescription": "Matcharound uses your location to show people near you."
      }
    },
    "android": {
      "package": "com.matcharound.app",
      "adaptiveIcon": {
        "backgroundColor": "#120A12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#120A12"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Matcharound uses the camera for video calls with nearby matches.",
          "microphonePermission": "Matcharound uses the microphone for voice and video calls.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Matcharound uses your location to show people near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
